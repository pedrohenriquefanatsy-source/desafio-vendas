# Copie para .env.local e preencha.
# Onde encontrar: painel do Supabase → seu projeto → Project Settings → API Keys
# (ou botão "Connect" no topo do painel).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Não use a chave service_role / secret neste projeto (decisão D3 do plano).
